{
  "platform": {
    "apiRuntime": "python:3.11"
  },
  "routes": [
    { "route": "/", "redirect": "/submit", "statusCode": 302 },
    { "route": "/signin", "redirect": "/submit", "statusCode": 302 },
    { "route": "/signup", "redirect": "/submit", "statusCode": 302 },
    { "route": "/submit", "rewrite": "/user/submit-ticket.html" },
    { "route": "/lists", "redirect": "/submit", "statusCode": 302 },
    { "route": "/details", "redirect": "/submit", "statusCode": 302 },
    { "route": "/settings", "redirect": "/submit", "statusCode": 302 },
    { "route": "/admin/login", "rewrite": "/admin/login.html" },
    { "route": "/admin", "rewrite": "/admin/ticket-lists.html" },
    { "route": "/admin/lists", "rewrite": "/admin/ticket-lists.html" },
    { "route": "/admin/details", "rewrite": "/admin/ticket-details.html" },
    { "route": "/admin/settings", "redirect": "/admin", "statusCode": 302 },
    { "route": "/admin/*", "redirect": "/admin/login", "statusCode": 302 },
    { "route": "/api/*", "allowedRoles": ["anonymous"] }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/api/*", "/css/*", "/js/*", "/*.{png,jpg,svg,ico,webp}"]
  },
  "responseOverrides": {
    "404": { "rewrite": "/index.html", "statusCode": 200 }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "mimeTypes": {
    ".json": "application/json",
    ".js": "text/javascript"
  }
}
